---
/** Numaralı bölüm başlığı: "03 — Bahçeden kutuya, sekiz adım." */
import type { SectionHeading } from '@/content/types';
interface Props {
  heading: SectionHeading;
  id: string;
  as?: 'h2' | 'h3';
  class?: string;
}
const { heading, id, as: Tag = 'h2', class: cls } = Astro.props;
---

<div class:list={['section-heading', cls]}>
  {
    heading.no && (
      <p class="section-label label" aria-hidden="true">
        <span class="section-label__no">{heading.no}</span>
        <span class="section-label__rule" />
      </p>
    )
  }
  <Tag id={id} class="section-heading__title" data-reveal="lines">
    {heading.no && <span class="sr-only">{heading.no} — </span>}
    {heading.title}
  </Tag>
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--sp-5);
  }
  .section-heading__title {
    font-size: var(--fs-h2);
    max-inline-size: 16ch;
  }
</style>
