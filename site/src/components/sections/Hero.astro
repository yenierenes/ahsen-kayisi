---
/**
 * Hero — "Güneşin meyvesi." Sabit ≈420lvh (mobil 300lvh) sahne.
 * Katman sırası: canvas hero → başlık → canvas hero-fg (meyve harflerin ÖNÜNDE) → güneş → arayüz.
 * Koreografi: src/lib/hero/hero.ts
 */
import { getContent } from '@/content';
const { hero: c } = getContent();
---

<!-- İmleç etiketi yok: alttaki kaydırma ipucu bunu zaten söylüyor, disk meyveyi örtmesin -->
<section id="hero" class="hero" data-hero data-sky="void" data-pin aria-labelledby="hero-title">
  <div class="hero__stage" data-pin-stage data-hero-stage>
    <div class="hero__layer" data-hero-bg>
      <canvas
        class="hero__canvas"
        data-hero-canvas
        data-sequence={c.sequence.base}
        data-sequence-group="hero"
        data-sequence-eager
        data-fit="cover"
        data-fit-portrait="contain"
        data-zoom-portrait="2.1"
        data-bg="auto"
        role="img"
        aria-label={c.sequence.alt}></canvas>
    </div>

    <div class="hero__glow" data-hero-glow aria-hidden="true"></div>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__line hero__line--1" data-hero-line><span class="hero__line-inner" data-hero-line-inner>{c.titleLines[0]}</span></span>{' '}
      <span class="hero__line hero__line--2" data-hero-line><span class="hero__line-inner" data-hero-line-inner><em>{c.titleLines[1]}</em></span></span>
    </h1>

    <div class="hero__layer" data-hero-fg aria-hidden="true">
      <canvas
        class="hero__canvas hero__canvas--fg"
        data-hero-canvas
        data-sequence={c.sequence.fg}
        data-sequence-group="hero"
        data-sequence-fallback="mirror"
        data-alpha
        data-fit="cover"
        data-fit-portrait="contain"
        data-zoom-portrait="2.1"></canvas>
    </div>

    <div class="hero__sun sun-fill" data-hero-sun aria-hidden="true"></div>

    <div class="hero__ui" data-hero-ui>
      <p class="hero__eyebrow label" data-hero-intro>{c.eyebrow}</p>

      <ol class="hero__captions" role="list">
        {
          c.captions.map((cap, i) => (
            <li class={`hero__caption hero__caption--${i % 2 ? 'right' : 'left'}`} data-hero-caption>
              <span class="hero__cap-head">
                <span class="hero__cap-rule" data-cap-rule aria-hidden="true" />
              </span>
              <p class="hero__cap-title" data-cap-part>
                {cap.title}
              </p>
              <p class="hero__cap-text" data-cap-part>
                {cap.text}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="hero__bottom">
        <p class="hero__readout label" data-hero-intro aria-hidden="true">
          <span>{c.dayLabel} <b data-hero-day data-total={c.dayTotal}>0</b> / {c.dayTotal}</span>
          <span class="hero__daybar"><i data-hero-daybar></i></span>
        </p>
        <p class="hero__hint label" data-hero-hint aria-hidden="true">
          <span class="hero__hint-in" data-hero-intro>{c.scrollHint}<i></i></span>
        </p>
        <a class="hero__skip label" href={c.skip.href} data-hero-intro>{c.skip.label} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>

  <figure class="hero__static">
    <img src={c.sequence.lastFrame} alt={c.sequence.lastAlt} width="1600" height="900" loading="lazy" decoding="async" />
  </figure>
</section>

<style>
  .hero {
    --pin-len: 320lvh;
    position: relative;
    color: #f6ebdd;
  }
  @media (max-width: 767.98px) {
    .hero {
      --pin-len: 220lvh;
    }
  }
  .hero__stage {
    --void: #140b07;
    --fruit-x: 50%;
    --fruit-y: 50%;
    --fruit-rx: 13vh;
    --fruit-ry: 25vh;
    --hero-fs: clamp(4.5rem, 12vw, 19rem);
    --tuck: calc(var(--fruit-rx) * 0.26);
    background: var(--void);
    isolation: isolate;
  }
  :global(html:not(.js)) .hero__stage {
    background: var(--void) url('/seq/hero/f_0001.webp') center / cover no-repeat;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
    transform-origin: var(--fruit-x) var(--fruit-y);
    will-change: transform;
  }
  .hero__canvas {
    inline-size: 100%;
    block-size: 100%;
    transform-origin: var(--fruit-x) var(--fruit-y);
  }
  /* hero-fg yoksa: taban kareyi meyve çevresinde yumuşak elipsle maskele */
  .hero__canvas.is-fallback {
    mask-image: radial-gradient(
      calc(var(--fruit-rx) * 1.04) calc(var(--fruit-ry) * 1.04) at var(--fruit-x) var(--fruit-y),
      #000 80%,
      transparent 100%
    );
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--fruit-x) var(--fruit-y), rgba(246, 176, 78, 0.75), rgba(233, 138, 38, 0.35) 30%, transparent 62%);
    opacity: 0;
    transform-origin: var(--fruit-x) var(--fruit-y);
    pointer-events: none;
  }
  .hero__sun {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  /* --- Başlık: meyvenin arkasına giren iki satır ----------------------------- */
  .hero__title {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: var(--hero-fs);
    font-weight: 380;
    line-height: var(--lh-tight);
    letter-spacing: -0.045em;
    --soft: 30;
    color: #f6ebdd;
    pointer-events: none;
    text-wrap: nowrap;
  }
  .hero__line {
    position: absolute;
    display: block;
    overflow: clip;
    /* maske İ, Ş, Ç, Ğ işaretlerini kesmesin */
    padding-block: 0.2em 0.16em;
    padding-inline: 0.05em;
    white-space: nowrap;
  }
  .hero__line-inner {
    display: block;
  }
  .hero__line--1 {
    inset-inline-end: calc(100% - var(--fruit-x) + var(--fruit-rx) - var(--tuck));
    inset-block-start: calc(var(--fruit-y) - 1.1em);
  }
  .hero__line--2 {
    inset-inline-start: calc(var(--fruit-x) + var(--fruit-rx) - var(--tuck));
    inset-block-start: calc(var(--fruit-y) - 0.14em);
  }
  .hero__line em {
    font-style: italic;
    --soft: 100;
    --wonk: 1;
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    font-weight: 340;
  }
  /* Dikey ekran (telefon, dikey tablet): satırlar meyvenin üstüne ve altına */
  @media (max-aspect-ratio: 1/1) {
    .hero__stage {
      --hero-fs: min(21vw, 11rem);
    }
    .hero__line--1 {
      inset-inline: var(--gutter) auto;
      inset-block-start: calc(var(--fruit-y) - var(--fruit-ry) - 1.14em);
    }
    .hero__line--2 {
      inset-inline: auto var(--gutter);
      inset-block-start: calc(var(--fruit-y) + var(--fruit-ry) - 0.42em);
    }
  }

  /* --- Arayüz ---------------------------------------------------------------- */
  .hero__ui {
    position: absolute;
    inset: 0;
    padding: calc(var(--nav-h) + var(--sp-4)) var(--gutter) var(--sp-6);
    pointer-events: none;
  }
  .hero__ui a {
    pointer-events: auto;
  }
  .hero__eyebrow {
    color: var(--c-ink-muted-dark);
  }
  .hero__captions {
    position: absolute;
    inset: auto var(--gutter) calc(var(--sp-6) + 3.5rem);
    block-size: 0;
  }
  .hero__caption {
    position: absolute;
    inset-block-end: 0;
    inline-size: min(24rem, 30vw);
    display: grid;
    gap: var(--sp-3);
    visibility: hidden;
  }
  .hero__caption--left {
    inset-inline-start: 0;
  }
  .hero__caption--right {
    inset-inline-end: 0;
  }
  .hero__cap-head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    color: var(--c-apricot);
  }
  .hero__cap-rule {
    flex: 1;
    block-size: 1px;
    background: rgba(246, 235, 221, 0.4);
    transform-origin: 0 50%;
  }
  .hero__cap-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: 1;
    letter-spacing: var(--ls-heading);
    font-variation-settings: 'SOFT' 50;
    color: #f6ebdd;
    text-wrap: balance;
  }
  .hero__cap-text {
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--c-ink-muted-dark);
    max-inline-size: 30ch;
  }
  @media (max-width: 767.98px) {
    .hero__captions {
      inset-block-end: calc(var(--sp-6) + 3rem);
    }
    .hero__caption {
      inline-size: 100%;
      inset-inline: 0;
      padding: var(--sp-5) 0 0;
      background: linear-gradient(to top, rgba(20, 11, 7, 0.85), rgba(20, 11, 7, 0));
    }
  }

  .hero__bottom {
    position: absolute;
    inset: auto var(--gutter) var(--sp-5);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: var(--sp-4);
    color: var(--c-ink-muted-dark);
  }
  .hero__readout {
    display: grid;
    gap: var(--sp-2);
    justify-items: start;
  }
  .hero__readout b {
    font-weight: 500;
    color: var(--c-apricot);
  }
  .hero__daybar {
    display: block;
    inline-size: 7.5rem;
    block-size: 1px;
    background: rgba(246, 235, 221, 0.2);
  }
  .hero__daybar i {
    display: block;
    block-size: 100%;
    background: var(--c-apricot);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .hero__hint-in {
    display: grid;
    justify-items: center;
    gap: var(--sp-3);
  }
  .hero__hint-in i {
    inline-size: 1px;
    block-size: 2.75rem;
    background: linear-gradient(to bottom, rgba(246, 235, 221, 0.7), transparent);
    transform-origin: 50% 0;
    animation: hero-hint 2.2s var(--ease-in-out) infinite;
  }
  @keyframes hero-hint {
    0% {
      transform: scaleY(0);
      transform-origin: 50% 0;
    }
    50% {
      transform: scaleY(1);
      transform-origin: 50% 0;
    }
    51% {
      transform-origin: 50% 100%;
    }
    100% {
      transform: scaleY(0);
      transform-origin: 50% 100%;
    }
  }
  .hero__skip {
    justify-self: end;
    padding-block: var(--sp-2);
    color: #f6ebdd;
  }
  @media (max-width: 767.98px) {
    .hero__bottom {
      grid-template-columns: 1fr auto;
    }
    .hero__hint {
      display: none;
    }
  }

  /* --- reduced-motion / JS yok: sabitleme yok, kopya normal düzende ------------ */
  .hero__static {
    display: none;
  }
  :global(html.reduce) .hero__caption,
  :global(html:not(.js)) .hero__caption {
    visibility: visible;
  }
  :global(html.reduce) .hero__captions,
  :global(html:not(.js)) .hero__captions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    block-size: auto;
  }
  :global(html.reduce) .hero__caption,
  :global(html:not(.js)) .hero__caption {
    position: static;
    inline-size: auto;
    background: none;
    padding: 0;
  }
  :global(html.reduce) .hero__hint,
  :global(html:not(.js)) .hero__hint {
    display: none;
  }
  :global(html.reduce) .hero__static,
  :global(html:not(.js)) .hero__static {
    display: block;
    padding: var(--sp-8) var(--gutter);
    background: var(--void, #140b07);
  }
  .hero__static img {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--r-media);
  }
  @media (max-width: 767.98px) {
    :global(html.reduce) .hero__captions,
    :global(html:not(.js)) .hero__captions {
      grid-template-columns: 1fr;
      inset-block-end: calc(var(--sp-6) + 2.5rem);
    }
    :global(html.reduce) .hero__cap-text,
    :global(html:not(.js)) .hero__cap-text {
      display: none;
    }
  }
</style>

<script>
  import '@/lib/hero/hero';
</script>
