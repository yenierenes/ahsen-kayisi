---
/**
 * Rakamlar — kemik gökyüzünde "02 — Rakamlarla Malatya".
 * ≥1100px, ≥620px yüksek ve hareket açıkken: tek sabit sahne. Üstte başlık, ortada
 * dev rakam (içi Malatya'nın sergi alanlarının fotoğrafıyla dolu, kaydırdıkça akar),
 * altta altı adımlık ilerleme sırası ve dipnot. Rakamlar maskeden karakter karakter
 * yükselir, sayaçlar penceresinin başında biter; giden rakam yukarı çıkar.
 * Sahne 06 sahnedeyken biter (boş ekran yok).
 * Dar/alçak ekran, reduced-motion, JS yok: sade yığın liste (dar ekranda sayaçlı).
 * Koreografi: src/lib/rakamlar/rakamlar.ts
 */
import { getContent } from '@/content';
const { rakamlar: c } = getContent();

const pad = (n: number): string => String(n).padStart(2, '0');
---

<section id="rakamlar" class="rakamlar" data-rakamlar data-sky="bone" aria-labelledby="rakamlar-title">
  <div class="rakamlar__pin" data-rakamlar-pin>
    <div class="rakamlar__stage" data-rakamlar-stage>
      <div class="container rakamlar__inner">
        <header class="rakamlar__head">
          <div class="rakamlar__heading">
            <p class="section-label label" aria-hidden="true">
              <span class="section-label__no">{c.heading.no}</span>
              <span class="section-label__rule"></span>
            </p>
            <h2 id="rakamlar-title" class="rakamlar__title" data-reveal="lines">
              <span class="sr-only">{c.heading.no} — </span>{c.heading.title}
            </h2>
          </div>
          <p class="rakamlar__intro">{c.intro}</p>
        </header>

        <!-- Sahne: yalnız görsel (ekran okuyucu için aynı bilgi aşağıdaki listede) -->
        <div class="rakamlar__big" aria-hidden="true" data-rakamlar-big>
          {
            c.figures.map((f) => (
              <div class="fig-big" data-fig-big>
                <p class="fig-big__num num">
                  <span
                    class="fig-big__v"
                    data-fig-bigv
                    data-to={f.count?.to}
                    data-dec={f.count?.decimals ?? 0}
                  >
                    {f.value}
                  </span>
                  {f.unit && (
                    <span class="fig-big__u" data-fig-unit>
                      {f.unit}
                    </span>
                  )}
                </p>
                <div class="fig-big__meta">
                  <p class="fig-big__ctx" data-fig-bigtext>
                    {f.context}
                  </p>
                  <p class="fig-big__src label" data-fig-bigtext>
                    {f.source} · {f.year}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <ol class="rakamlar__ledger" data-rakamlar-ledger>
          {
            c.figures.map((f, i) => (
              <li class="fig" data-fig>
                <span class="fig__idx label" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <p class="fig__num num">
                  <span
                    class="fig__v"
                    data-fig-v
                    data-to={f.count?.to}
                    data-dec={f.count?.decimals ?? 0}
                    data-pre={f.count?.prefix ?? ''}
                    data-suf={f.count?.suffix ?? ''}
                  >
                    {f.value}
                  </span>
                  {f.unit && <span class="fig__u">{f.unit}</span>}
                </p>
                <p class="fig__short label" aria-hidden="true">
                  {f.short}
                </p>
                <span class="fig__bar" aria-hidden="true">
                  <span class="fig__barfill" data-fig-bar></span>
                </span>
                <div class="fig__text">
                  <p class="fig__ctx">{f.context}</p>
                  <p class="fig__src label label--plain">
                    {f.source} · {f.year}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="rakamlar__note label label--plain">{c.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .rakamlar {
    position: relative;
    padding-block: var(--section-y) var(--sp-9);
    /* Rakam dokusu: sergi alanı fotoğrafı; konumu rakamlar.ts kaydırmayla sürer */
    --tex: url('/media/foto/sergi-drone-2400.webp');
    --bg-w: 150vw;
    --bgx: -6vw;
    --bgy: -10vw;
  }

  /* ======================================================================
     Durağan düzen (varsayılan): dar ekran, alçak ekran, reduced-motion, JS yok
     ====================================================================== */
  .rakamlar__inner {
    display: block;
  }
  .rakamlar__head {
    display: grid;
    gap: var(--sp-6);
    margin-block-end: var(--sp-8);
  }
  .rakamlar__heading {
    display: grid;
    gap: var(--sp-5);
  }
  .rakamlar__title {
    font-size: var(--fs-h2);
    max-inline-size: 16ch;
  }
  .rakamlar__intro {
    color: var(--muted);
    font-size: var(--fs-lead);
    max-inline-size: 30ch;
  }
  .rakamlar__big {
    display: none;
  }
  .rakamlar__ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--line);
  }
  .fig {
    display: grid;
    gap: var(--sp-3) var(--gap);
    padding-block: var(--sp-7);
    border-block-end: 1px solid var(--line);
  }
  .fig__short,
  .fig__bar {
    display: none;
  }
  .fig__idx {
    color: var(--accent);
  }
  .fig__num,
  .fig-big__num {
    margin: 0;
    max-inline-size: none;
    inline-size: max-content;
    font-family: var(--font-display);
    font-weight: 340;
    font-optical-sizing: auto;
    --soft: 60;
    font-variation-settings:
      'SOFT' var(--soft),
      'WONK' var(--wonk);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--fg);
  }
  .fig__num {
    font-size: clamp(4rem, 2.4rem + 8vw, 9rem);
  }
  .fig__u,
  .fig-big__u {
    margin-inline-start: 0.28em;
    font-size: 0.3em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  .fig__ctx {
    font-size: var(--fs-lead);
    line-height: 1.3;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 50;
    max-inline-size: 26ch;
  }
  .fig__src {
    margin-block-start: var(--sp-3);
    color: var(--muted);
  }
  @media (min-width: 768px) {
    .rakamlar__head {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: end;
    }
    .fig {
      grid-template-columns: 3rem minmax(0, 5fr) minmax(0, 3fr);
      align-items: end;
      padding-block: var(--sp-8);
    }
    .fig__idx {
      align-self: start;
      padding-block-start: 0.5em;
    }
  }

  .rakamlar__note {
    margin-block-start: var(--sp-6);
    color: var(--muted);
    max-inline-size: 70ch;
  }

  /* ======================================================================
     Sabit sahne: yalnız geniş + yüksek ekranda ve hareket açıkken.
     (Medya sorgusu rakamlar.ts'teki "pin" koşuluyla birebir aynıdır;
      --pin-len, rakamlar.ts'teki zaman çizelgesi birimleriyle eşleşir.)
     ====================================================================== */
  @media (min-width: 1100px) and (min-height: 620px) {
    :global(html.motion-ok) .rakamlar {
      padding-block: var(--sp-7) 0;
    }
    :global(html.motion-ok) .rakamlar__pin {
      --pin-len: 462lvh; /* rakamlar.ts çizelgeden yeniden yazar */
      position: relative;
      block-size: calc(100vh + var(--pin-len));
      block-size: calc(100lvh + var(--pin-len));
    }
    :global(html.motion-ok) .rakamlar__stage {
      position: sticky;
      inset-block-start: 0;
      block-size: 100vh;
      block-size: 100lvh;
      overflow: clip;
    }
    :global(html.motion-ok) .rakamlar__inner {
      block-size: 100%;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      column-gap: var(--gap);
      padding-block: calc(var(--nav-h) + var(--sp-3)) var(--sp-5);
    }

    /* Başlık satırı */
    :global(html.motion-ok) .rakamlar__head {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      margin: 0;
      align-items: end;
    }
    :global(html.motion-ok) .rakamlar__heading {
      grid-column: 1 / span 7;
      display: flex;
      align-items: center;
      gap: var(--sp-5);
    }
    :global(html.motion-ok) .rakamlar__heading .section-label {
      flex: none;
    }
    :global(html.motion-ok) .rakamlar__title {
      font-size: var(--fs-h4);
      max-inline-size: none;
      line-height: 1;
      white-space: nowrap;
    }
    :global(html.motion-ok) .rakamlar__intro {
      grid-column: 9 / -1;
      font-size: var(--fs-body);
      line-height: 1.4;
      max-inline-size: 34ch;
    }

    /* Dev rakam */
    :global(html.motion-ok) .rakamlar__big {
      display: block;
      position: relative;
      grid-column: 1 / -1;
    }
    :global(html.motion-ok) .fig-big {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--sp-5);
      visibility: hidden; /* rakamlar.ts açar; JS yoksa asla gösterilmez */
    }
    :global(html.motion-ok) .fig-big__num {
      /* Tavan: genişlik ve yükseklik; rakamlar.ts satır sığmazsa --fit ile küçültür */
      --fs-max: min(clamp(7rem, 30vw, 30rem), 50svh);
      font-size: calc(var(--fs-max) * var(--fit, 1));
      line-height: 1;
      letter-spacing: -0.055em;
      font-weight: 330;
      margin-inline-start: -0.04em;
    }
    :global(html.motion-ok) .fig-big__v {
      position: relative;
      display: inline-block;
    }
    :global(html.motion-ok) .fig-big__u {
      display: inline-block;
      margin-inline-start: 0.18em;
      font-size: 0.2em;
      letter-spacing: -0.01em;
      color: var(--c-apricot-deep);
    }
    :global(html.motion-ok) .fig-big__meta {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: end;
    }
    :global(html.motion-ok) .fig-big__ctx {
      grid-column: 1 / span 7;
      margin: 0;
      max-inline-size: 30ch;
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 0.8rem + 1.9vw, 3rem);
      line-height: 1.12;
      letter-spacing: -0.02em;
      font-variation-settings: 'SOFT' 50;
      text-wrap: balance;
    }
    :global(html.motion-ok) .fig-big__src {
      grid-column: 9 / -1;
      margin: 0;
      color: var(--muted);
    }

    /* Karakter maskeleri (rakamlar.ts oluşturur) */
    :global(html.motion-ok) .rakamlar :global(.fig-ch) {
      display: inline-block;
      /* Maske: üstte ve altta virgül/kuyruk payı; yükselen karakter payın dışında başlar */
      clip-path: inset(-0.08em -0.2em -0.11em);
    }
    :global(html.motion-ok) .rakamlar :global(.fig-ch__i) {
      display: inline-block;
      color: var(--c-apricot-deep);
      will-change: transform;
      transition: opacity var(--dur-1) linear;
    }
    @supports ((-webkit-background-clip: text) or (background-clip: text)) {
      :global(html.motion-ok) .rakamlar :global(.fig-ch__i) {
        color: transparent;
        background-color: var(--c-apricot-strong);
        background-image: var(--tex);
        background-blend-mode: multiply;
        background-repeat: no-repeat;
        background-size: var(--bg-w) auto;
        background-position: calc(var(--bgx) - var(--ox, 0px)) calc(var(--bgy) - var(--oy, 0px));
        -webkit-background-clip: text;
        background-clip: text;
      }
    }

    /* İlerleme sırası: 01 — 06 ve kısa etiketler */
    :global(html.motion-ok) .rakamlar__ledger {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--gap);
      border: 0;
    }
    :global(html.motion-ok) .fig {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-items: baseline;
      gap: var(--sp-3) var(--sp-3);
      padding-block: 0;
      border: 0;
      color: var(--muted);
      transition: color var(--dur-2) var(--ease-soft);
    }
    :global(html.motion-ok) .fig.is-active {
      color: var(--fg);
    }
    :global(html.motion-ok) .fig__bar {
      display: block;
      grid-column: 1 / -1;
      grid-row: 1;
      block-size: 2px;
      background: var(--line);
      overflow: hidden;
    }
    :global(html.motion-ok) .fig__barfill {
      display: block;
      block-size: 100%;
      background: var(--c-apricot-strong);
      transform: scaleX(0);
      transform-origin: 0 50%;
    }
    :global(html.motion-ok) .fig__idx {
      grid-row: 2;
      padding: 0;
      color: inherit;
    }
    :global(html.motion-ok) .fig.is-active .fig__idx {
      color: var(--accent);
    }
    :global(html.motion-ok) .fig__short {
      display: block;
      grid-row: 2;
      margin: 0;
      max-inline-size: none;
      color: inherit;
    }
    /* Rakam, tam cümle ve kaynak: görsel olarak gizli, ekran okuyucuya açık */
    :global(html.motion-ok) .fig__num,
    :global(html.motion-ok) .fig__text {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Dipnot: sahnenin alt kenarında */
    :global(html.motion-ok) .rakamlar__note {
      grid-column: 1 / -1;
      margin-block-start: var(--sp-4);
      padding-block-start: var(--sp-3);
      border-block-start: 1px solid var(--line);
      max-inline-size: none;
    }
  }

  /* Alçak geniş ekran: başlık satırını sadeleştir */
  @media (min-width: 1100px) and (min-height: 620px) and (max-height: 799.98px) {
    :global(html.motion-ok) .rakamlar__intro {
      display: none;
    }
    :global(html.motion-ok) .fig-big__num {
      --fs-max: min(clamp(7rem, 30vw, 30rem), 36svh);
    }
    :global(html.motion-ok) .fig-big__ctx {
      font-size: clamp(1.5rem, 0.8rem + 1.2vw, 2.25rem);
    }
  }
</style>

<script>
  import '@/lib/rakamlar/rakamlar';
</script>
