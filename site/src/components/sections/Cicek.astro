---
/**
 * Çiçek — "BAHAR". Rakamlar ile Süreç arasında, numarasız önsöz.
 * Sabit ≈420lvh (mobil 340lvh) sahne. Dört vuruş, dört çekim: her vuruşun kısa, döngülü videosu
 * GERÇEK ZAMANLI oynar (kaydırma durunca da görüntü canlı); kaydırma vuruşu, dolayısıyla çekimi değiştirir.
 * Vuruş sınırında zamana bağlı film geçişi (≈0.7 s çapraz karışım + hafif ölçek oturması); kaydırma
 * çekimin yavaş yaklaşmasını (1.00→1.07), yazıyı ve yaprak rüzgârını sürer.
 * Katmanlar (alttan üste):
 *   kemik zemin (çıkışta) → çekim katmanları (poster <img> + <video>) → açık örtü (+ çekime göre ek güç) →
 *   uzak + orta yapraklar → dört vuruşluk yazı → yakın yapraklar.
 * Sayfa rengi kemiğe sahnenin en sonunda (0.995–1) tek hamlede döner; görünen geçişi
 * .cicek__under katmanı yapar. Bölümün altında Süreç girişine taşan küçük bir "köprü" yaprak alanı.
 * Koreografi + video yönetimi: src/lib/cicek/cicek.ts · yaprak sistemi: src/lib/cicek/petals.ts
 *
 * Derleme/istek anında (dosya yoksa 404 yok; dosya gelince kod değişmeden kullanılır):
 *  - /media/video/bahar-N{.mp4,-m.mp4,.jpg}: N yoksa 1. çekim, o da yoksa durağan foto (cicek-safak-*).
 *    Aynı klibi kullanan vuruşlar tek katmanı paylaşır (geçiş olmaz, aynı video sürer).
 *  - Yaprak/çiçek kesimleri public/media/kesim/ klasöründen okunur
 *    (cicek-N-500.webp, petal-N-300.webp); hiçbiri yoksa tek cicek-500.webp.
 */
// @ts-ignore -- projede @types/node yok; kod yalnızca derleme/istek anında Node'da çalışır
import fs from 'node:fs';
import { getContent } from '@/content';
const { cicek: c } = getContent();

const cwd = (globalThis as { process?: { cwd(): string } }).process?.cwd() ?? '.';
const pub = (url: string): string => `${cwd}/public/${url.replace(/^\/+/, '')}`;
const has = (url: string): boolean => fs.existsSync(pub(url));

// --- Çekimler -------------------------------------------------------------------
const s = c.still;
const stillPoster = `${s.base}-1200.webp`;
interface Clip {
  key: string;
  src: string;
  srcM: string;
  poster: string;
  still: boolean;
}
const clipOf = (base: string): Clip | null => {
  if (!base || !has(`${base}.mp4`)) return null;
  return {
    key: base,
    src: `${base}.mp4`,
    srcM: has(`${base}-m.mp4`) ? `${base}-m.mp4` : `${base}.mp4`,
    poster: has(`${base}.jpg`) ? `${base}.jpg` : stillPoster,
    still: false,
  };
};
const firstClip = clipOf(c.beats[0]?.shot.base ?? '');
const stillClip: Clip = { key: 'still', src: '', srcM: '', poster: stillPoster, still: true };
const perBeat: Clip[] = c.beats.map((b) => clipOf(b.shot.base) ?? firstClip ?? stillClip);
/** benzersiz klip başına bir katman; `beat` = katmanın asıl sahibi (alt + örtü gücü ondan) */
const layers: { clip: Clip; beat: number }[] = [];
const beatLayer: number[] = perBeat.map((cl, i) => {
  let k = layers.findIndex((l) => l.clip.key === cl.key);
  if (k < 0) {
    k = layers.length;
    layers.push({ clip: cl, beat: i });
  }
  return k;
});
const layerAlt = (k: number): string => {
  const l = layers[k];
  if (!l) return s.alt;
  return l.clip.still ? s.alt : (c.beats[l.beat]?.shot.alt ?? s.alt);
};
const shotMap = JSON.stringify({
  beat: beatLayer,
  wash: layers.map((l) => c.beats[l.beat]?.shot.wash ?? 0),
});

// --- Yapraklar ------------------------------------------------------------------
let files: string[] = [];
try {
  files = (fs.readdirSync(pub('/media/kesim/')) as string[]).slice();
} catch {
  files = [];
}
const byNo = (a: string, b: string): number => Number(/\d+/.exec(a)?.[0] ?? 0) - Number(/\d+/.exec(b)?.[0] ?? 0);
let blossoms = files.filter((f) => /^cicek-\d+-500\.webp$/.test(f)).sort(byNo).map((f) => `/media/kesim/${f}`);
const petals = files.filter((f) => /^petal-\d+-300\.webp$/.test(f)).sort(byNo).map((f) => `/media/kesim/${f}`);
if (!blossoms.length && !petals.length) blossoms = [c.spriteFallback.src];
const sprites = JSON.stringify({ b: blossoms, p: petals });

// reduced-motion / JS yok: kenarlara oturan 6 durağan kesim (2 çiçek + 4 yaprak)
const pickB = (i: number): string => blossoms[i % Math.max(1, blossoms.length)] ?? petals[i % petals.length] ?? c.spriteFallback.src;
const pickP = (i: number): string => petals[i % Math.max(1, petals.length)] ?? pickB(i);
const rest = [
  { src: pickB(0), style: 'left:-1.5%; top:-7%; --s:clamp(4.5rem, 9vw, 8rem); --r:-14deg' },
  { src: pickP(0), style: 'left:21%; top:-3.5%; --s:clamp(1.6rem, 2.4vw, 2.4rem); --r:32deg' },
  { src: pickP(1), style: 'right:5%; top:7%; --s:clamp(2rem, 3.2vw, 3.2rem); --r:-48deg' },
  { src: pickB(1), style: 'right:-2%; bottom:9%; --s:clamp(5rem, 11vw, 10rem); --r:22deg' },
  { src: pickP(2), style: 'left:7%; bottom:-4%; --s:clamp(2rem, 3vw, 3rem); --r:64deg' },
  { src: pickP(3), style: 'left:44%; bottom:-3%; --s:clamp(1.4rem, 2vw, 2rem); --r:-18deg' },
];
---

<section
  id="cicek"
  class="cicek"
  data-cicek
  data-sky="blossom"
  data-sky-to="bone"
  data-sky-to-range="0.995 1"
  data-pin
  aria-labelledby="cicek-title"
>
  <div class="cicek__stage" data-pin-stage data-cicek-stage>
    <h2 id="cicek-title" class="sr-only">{c.srTitle}</h2>

    <div class="cicek__under" data-cicek-under aria-hidden="true"></div>
    <div class="cicek__frame">
      <div class="cicek__media" data-cicek-media>
        <div class="cicek__zoom" data-cicek-zoom>
          <div class="cicek__shots" data-cicek-shots data-map={shotMap} role="img" aria-label={layerAlt(0)}>
            {
              layers.map((l, k) => (
                <div class="cicek__shot" data-cicek-shot data-alt={layerAlt(k)}>
                  <div class="cicek__settle" data-cicek-settle>
                    {l.clip.still ? (
                      <picture class="cicek__still">
                        <source type="image/avif" srcset={`${s.base}-1600.avif ${s.widthAvif}w`} sizes="100vw" />
                        <img
                          src={`${s.base}-1200.webp`}
                          srcset={`${s.base}-1200.webp ${s.width}w, ${s.base}-2400.webp ${s.widthLg}w`}
                          sizes="100vw"
                          width={s.width}
                          height={s.height}
                          alt=""
                          decoding="async"
                        />
                      </picture>
                    ) : (
                      <img
                        class="cicek__poster"
                        src={l.clip.poster}
                        width="1280"
                        height="720"
                        alt=""
                        loading={k === 0 ? 'eager' : 'lazy'}
                        fetchpriority={k === 0 ? 'auto' : 'low'}
                        decoding="async"
                      />
                    )}
                    {!l.clip.still && (
                      <video
                        class="cicek__video"
                        data-cicek-video
                        data-src={l.clip.src}
                        data-src-m={l.clip.srcM}
                        muted
                        playsinline
                        loop
                        preload="none"
                        disablepictureinpicture
                        disableRemotePlayback
                        tabindex="-1"
                        aria-hidden="true"
                      />
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="cicek__wash" data-cicek-wash aria-hidden="true">
          <i class="cicek__wash-boost" data-cicek-boost></i>
        </div>
      </div>

      <!-- çıkış kartının 24px köşeleri (cicek.ts konumlar; dikdörtgen kırpmanın üstünde) -->
      <div class="cicek__corners" aria-hidden="true">
        <i data-cicek-corner data-c="tl"></i><i data-cicek-corner data-c="tr"></i><i data-cicek-corner data-c="bl"></i><i data-cicek-corner data-c="br"></i>
      </div>
    </div>

    <div class="cicek__rest" aria-hidden="true">
      {rest.map((r) => <img src={r.src} alt="" style={r.style} loading="lazy" decoding="async" />)}
    </div>

    <!-- Yaprak alanı: petals.ts doldurur. Uzak + orta yazının arkasında, yakın önünde. -->
    <div class="cicek__field" data-cicek-field data-sprites={sprites} aria-hidden="true">
      <div class="cicek__layer" data-depth="0"></div>
      <div class="cicek__layer" data-depth="1"></div>
    </div>

    <div class="cicek__ui">
      <ol class="cicek__beats" role="list" data-cicek-beats>
        {
          c.beats.map((b, i) => {
            const k = beatLayer[i] ?? 0;
            const own = layers[k]?.beat === i;
            return (
              <li class="cicek__beat" data-cicek-beat>
                <img
                  class="cicek__beat-img"
                  src={perBeat[i]?.poster ?? stillPoster}
                  width="1280"
                  height="720"
                  alt={own ? layerAlt(k) : ''}
                  loading="lazy"
                  decoding="async"
                />
                <p class="cicek__label label">
                  <span class="cicek__mask">
                    <span class="cicek__mask-in" data-cicek-part>
                      {c.label}
                      <span class="cicek__dots" aria-hidden="true">
                        {c.beats.map((_, j) => <i class:list={{ 'is-on': j === i }} />)}
                      </span>
                    </span>
                  </span>
                </p>
                <p class="cicek__title" data-cicek-split>
                  {b.title}
                </p>
                <p class="cicek__text" data-cicek-split>
                  {b.text}
                </p>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="cicek__field cicek__field--near" data-cicek-near aria-hidden="true">
      <div class="cicek__layer" data-depth="2"></div>
    </div>
  </div>

  <!-- Köprü: Süreç girişine taşan birkaç yaprak (sahne bitince de düşer) -->
  <div class="cicek__bridge" data-cicek-bridge aria-hidden="true"></div>
</section>

<style>
  .cicek {
    --pin-len: 420lvh;
    position: relative;
    z-index: var(--z-raised);
    color: var(--fg);
  }
  @media (max-width: 767.98px) {
    .cicek {
      --pin-len: 340lvh;
    }
  }
  .cicek__stage {
    isolation: isolate;
  }
  /* Çıkışta çerçevenin çevresinde görünen kemik zemin (cicek.ts opaklığını açar) */
  .cicek__under {
    position: absolute;
    inset: 0;
    background: var(--c-bone);
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }
  .cicek__corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cicek__corners i {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 24px;
    block-size: 24px;
    transform: scale(0);
    will-change: transform;
    --g: transparent 23.25px, var(--c-bone) 24px;
  }
  .cicek__corners i[data-c='tl'] {
    transform-origin: 0 0;
    background: radial-gradient(circle at 100% 100%, var(--g));
  }
  .cicek__corners i[data-c='tr'] {
    transform-origin: 100% 0;
    background: radial-gradient(circle at 0 100%, var(--g));
  }
  .cicek__corners i[data-c='bl'] {
    transform-origin: 0 100%;
    background: radial-gradient(circle at 100% 0, var(--g));
  }
  .cicek__corners i[data-c='br'] {
    transform-origin: 100% 100%;
    background: radial-gradient(circle at 0 0, var(--g));
  }

  /* --- Medya ------------------------------------------------------------------ */
  .cicek__frame,
  .cicek__media,
  .cicek__zoom,
  .cicek__shots,
  .cicek__shot,
  .cicek__settle {
    position: absolute;
    inset: 0;
  }
  .cicek__media {
    overflow: clip;
    background: var(--c-blossom);
  }
  .cicek__zoom {
    transform-origin: 50% 46%;
  }
  /* Çekim katmanları: cicek.ts opaklık (geçiş) + ölçek (yavaş yaklaşma) yazar */
  .cicek__shot {
    transform-origin: 50% 46%;
    will-change: transform, opacity;
  }
  .cicek__shot:not(:first-child) {
    opacity: 0;
  }
  .cicek__settle {
    transform-origin: 50% 46%;
  }
  .cicek__still,
  .cicek__still img,
  .cicek__poster,
  .cicek__video {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 46%;
  }
  /* kaynakların üst kenarındaki 2–3 px'lik koyu şerit kadraj dışında kalsın */
  .cicek__poster,
  .cicek__video {
    inset-block-start: -0.6%;
    block-size: 100.6%;
  }
  /* video ilk karesini gösterene dek altındaki poster görünür (boş kare yok) */
  .cicek__video {
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  .cicek__video.is-live {
    opacity: 1;
  }
  .cicek.is-noautoplay .cicek__video {
    display: none;
  }

  /* Açık örtü: yazı alanının arkasında yumuşak krem ışık (kutu değil) */
  .cicek__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: opacity;
    background:
      radial-gradient(ellipse 58% 62% at 14% 30%, rgba(246, 235, 221, 0.9) 0%, rgba(246, 235, 221, 0.66) 42%, rgba(246, 235, 221, 0) 100%),
      linear-gradient(to bottom, rgba(246, 235, 221, 0.35), rgba(246, 235, 221, 0) 34%);
  }
  /* çekime göre ek krem ışık (koyu/mavi çekimde yazı okunur kalsın); opaklığı cicek.ts yazar */
  .cicek__wash-boost {
    position: absolute;
    inset: 0;
    opacity: 0;
    will-change: opacity;
    background: radial-gradient(
      ellipse 62% 72% at 14% 30%,
      rgba(246, 235, 221, 0.72) 0%,
      rgba(246, 235, 221, 0.5) 46%,
      rgba(246, 235, 221, 0) 100%
    );
  }
  @media (max-width: 767.98px) {
    .cicek__wash {
      background: linear-gradient(
        to bottom,
        rgba(246, 235, 221, 0.88) 0%,
        rgba(246, 235, 221, 0.74) 32%,
        rgba(246, 235, 221, 0.36) 46%,
        rgba(246, 235, 221, 0) 58%
      );
    }
    .cicek__wash-boost {
      background: linear-gradient(to bottom, rgba(246, 235, 221, 0.7) 0%, rgba(246, 235, 221, 0.5) 40%, rgba(246, 235, 221, 0) 60%);
    }
  }

  /* --- Yaprak alanı ------------------------------------------------------------ */
  .cicek__field,
  .cicek__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cicek__layer {
    will-change: transform;
  }
  .cicek__field :global(.cicek-sprite) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--s);
    block-size: var(--s);
    will-change: transform;
  }
  .cicek__field :global(.cicek-sprite img),
  .cicek__bridge :global(.cicek-sprite img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
  .cicek__field :global(.cicek-sprite[data-d='0']) {
    opacity: 0.82;
  }
  /* yakın katmanın yumuşaklığı canlı filtre değil: petals.ts bir kez bulanık kopya üretir */
  .cicek__bridge {
    position: absolute;
    inset-inline: 0;
    /* sahnenin son konumundan başlar, Süreç girişine taşar */
    inset-block-start: calc(100% - 100lvh);
    block-size: 165lvh;
    pointer-events: none;
  }
  .cicek__bridge :global(.cicek-sprite) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--s);
    block-size: var(--s);
    will-change: transform;
  }

  /* --- Yazılar ----------------------------------------------------------------- */
  .cicek__ui {
    position: absolute;
    inset: 0;
    padding: calc(var(--nav-h) + var(--sp-6)) var(--gutter) var(--sp-6);
    pointer-events: none;
  }
  .cicek__beats {
    display: grid;
    inline-size: min(36rem, 46vw);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cicek__beat {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    gap: var(--sp-4);
    visibility: hidden;
  }
  .cicek__label {
    color: var(--c-apricot-deep);
  }
  .cicek__label b {
    font-weight: 600;
  }
  .cicek__mask {
    display: block;
    overflow: clip;
    padding-block: 0.2em 0.16em;
    margin-block: -0.2em -0.16em;
  }
  .cicek__mask-in {
    display: block;
  }
  .cicek__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.3rem + 3.4vw, 5.25rem);
    font-weight: 380;
    line-height: 1.02;
    letter-spacing: var(--ls-heading);
    font-variation-settings: 'SOFT' 60;
    color: var(--c-night);
    text-wrap: balance;
  }
  .cicek__text {
    margin: 0;
    max-inline-size: 34ch;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--c-night);
    text-wrap: pretty;
  }
  /* masaüstü: tam ekran fotoğrafta kaybolmasın diye daha iri satır + cümle
     (yaprak hariç tutma kutusu cicek.ts'te .cicek__beats ölçüsünden okunur → büyüyen kutuyu izler) */
  @media (min-width: 768px) {
    .cicek__title {
      font-size: clamp(2.5rem, 5.2vw, 5.5rem);
    }
    .cicek__text {
      max-inline-size: 30ch;
      font-size: clamp(1rem, 1.25vw, 1.25rem);
      line-height: 1.45;
    }
  }
  @media (max-width: 767.98px) {
    .cicek__ui {
      padding-block-start: calc(var(--nav-h) + var(--sp-4));
    }
    .cicek__beats {
      inline-size: 100%;
    }
    .cicek__beat {
      gap: var(--sp-3);
    }
    .cicek__title {
      font-size: clamp(2rem, 1.2rem + 4.2vw, 2.75rem);
    }
  }

  /* --- reduced-motion / JS yok: sabitleme yok; foto çerçevede, yazılar altında --- */
  .cicek__rest {
    display: none;
  }
  :global(html:not(.js)) .cicek {
    block-size: auto;
  }
  :global(html.reduce) .cicek,
  :global(html:not(.js)) .cicek {
    padding-block: var(--section-y);
  }
  :global(html.reduce) .cicek__stage,
  :global(html:not(.js)) .cicek__stage {
    position: relative;
    block-size: auto;
    min-block-size: 0;
    overflow: visible;
    display: grid;
    gap: var(--sp-7);
    padding-inline: var(--gutter);
  }
  /* durağan düzende tam ekran çekim yerine her vuruşun kendi posteri kartın üstünde */
  .cicek__beat-img {
    display: none;
  }
  :global(html.reduce) .cicek__beat-img,
  :global(html:not(.js)) .cicek__beat-img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* yuvarlak köşe + kaynağın üst kenarındaki koyu şeridi kırp */
    clip-path: inset(0.8% 0 0 0 round var(--r-media));
    margin-block-end: var(--sp-2);
  }
  :global(html.reduce) .cicek__frame,
  :global(html:not(.js)) .cicek__frame,
  :global(html.reduce) .cicek__wash,
  :global(html:not(.js)) .cicek__wash,
  :global(html.reduce) .cicek__under,
  :global(html:not(.js)) .cicek__under,
  :global(html.reduce) .cicek__corners,
  :global(html:not(.js)) .cicek__corners,
  :global(html.reduce) .cicek__field,
  :global(html:not(.js)) .cicek__field,
  :global(html.reduce) .cicek__bridge,
  :global(html:not(.js)) .cicek__bridge {
    display: none;
  }
  :global(html.reduce) .cicek__rest,
  :global(html:not(.js)) .cicek__rest {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cicek__rest img {
    position: absolute;
    inline-size: var(--s);
    block-size: var(--s);
    object-fit: contain;
    transform: rotate(var(--r));
  }
  .cicek__dots {
    display: inline-flex;
    gap: 0.4em;
    margin-inline-start: 0.9em;
    vertical-align: 0.05em;
  }
  .cicek__dots i {
    inline-size: 0.4em;
    block-size: 0.4em;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
    opacity: 0.6;
  }
  .cicek__dots i.is-on {
    background: currentColor;
    opacity: 1;
  }
  .cicek__rest img:nth-child(4) {
    filter: blur(1px);
  }
  :global(html.reduce) .cicek__ui,
  :global(html:not(.js)) .cicek__ui {
    position: static;
    padding: 0;
  }
